# --- required ---
# From @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram id (send /id to the bot, or ask @userinfobot). Comma-separated.
ADMIN_IDS=
# Encrypts stored MT5 passwords. Generate once and never change:
#   python -m tradegenius.crypto
ENCRYPTION_KEY=

# --- AI strategy parsing (text, screenshots, PDF) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Strategy analyses per user per day (admins unlimited).
AI_DAILY_LIMIT=20

# --- access & billing ---
# false = free testing mode for everyone. Admins are always free.
BILLING_ENABLED=false
# Optional closed beta: only these Telegram ids may use the bot (comma-separated).
ALLOWED_USER_IDS=
# Telegram Payments provider token (from @BotFather -> Payments), needed when billing is on.
PAYMENT_PROVIDER_TOKEN=
# Price in minor units (3900 = 39.00).
PRICE_AMOUNT=3900
PRICE_CURRENCY=USD
SUBSCRIPTION_DAYS=30
TRIAL_DAYS=0

# --- capacity ---
MAX_ACTIVE_ENGINES=3
MAX_ACCOUNTS_PER_USER=1
BACKTEST_BARS=3000

# --- local development ---
# DATA_DIR=./data
# ENGINES_ENABLED=false   # run only the bot locally (no Wine/MT5)
